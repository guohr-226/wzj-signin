# Copy to config.secrets.toml and fill in local credentials.
# Never commit config.secrets.toml or real credentials.

[default]
openId = "your_open_id_or_full_url"
courseId = "your_course_id"
studentId = "your_student_id"

[email]
sender = "your@qq.com"
password = "your_smtp_authorization_code"
receiver = "notify@example.com"
